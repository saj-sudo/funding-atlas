lerts-page-specific\">\n<div><div class=\"js-view-dom-id-84e8abc9dcdc9065688aa8533fb3ad5bf9b702882bd4374e937c01941a637890\">\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"grid-container\">\n<div class=\"grid-row grid-gap\">\n<aside class=\"layout-sidebar-first grid-col-12 desktop:grid-col-3 margin-top-8 desktop:margin-top-10 desktop:margin-bottom-15\" role=\"complementary\">\n<a class=\"usa-skipnav maryland-link maryland-link--skipnav\" href=\"#page-content\">Skip sidebar navigation</a>\n<nav aria-labelledby=\"sidenav-title\" class=\"maryland-sidenav\">\n<button aria-controls=\"sidenav\" class=\"maryland-sidenav__toggle\" type=\"button\">\n<span class=\"usa-sr-only\">Close</span>\n<h2 class=\"maryland-sidenav__title\" id=\"sidenav-title\">Section Menu</h2>\n</button>\n<ul class=\"maryland-sidenav__list maryland-sidenav__list--level-1\" data-region=\"sidebar_first\" id=\"sidenav\">\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-1\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-1\" data-drupal-link-system-path=\"node/2\" href=\"/funding\">Funding</a>\n<ul class=\"maryland-sidenav__list maryland-sidenav__list--level-2\" data-region=\"sidebar_first\">\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<span aria-current=\"page\" class=\"maryland-sidenav__link maryland-sidenav__link--level-2\">How to Apply for a Grant</span>\n</li>\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-2\" data-drupal-link-system-path=\"node/748\" href=\"/funding/african-american-heritage-preservation-program-grants\">African American Heritage Preservation Program Grants</a>\n</li>\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-2\" data-drupal-link-system-path=\"node/10\" href=\"/funding/historic-preservation-capital-grant-program\">Historic Preservation Capital Grant Program</a>\n</li>\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-2\" data-drupal-link-system-path=\"node/11\" href=\"/funding/historic-preservation-non-capital-grant-program\">Historic Preservation Non-Capital Grant Program</a>\n</li>\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-2\" data-drupal-link-system-path=\"node/12\" href=\"/planning-protection/maryland-heritage-areas-program/maryland-heritage-areas-program-project-grants\">Maryland Heritage Areas Program Project Grants</a>\n</li>\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-2\" data-drupal-link-system-path=\"node/13\" href=\"/funding/museum-assistance-program-grants\">Museum Assistance Program Grants</a>\n</li>\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-2\" data-drupal-link-system-path=\"node/497\" href=\"/funding/maritime-heritage-grant-program\">Maritime Heritage Grant Program</a>\n</li>\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-2\" data-drupal-link-system-path=\"node/172\" href=\"/funding/tax-credits\">Tax Credits</a>\n</li>\n<li class=\"maryland-sidenav__item maryland-sidenav__item--level-2\">\n<a class=\"maryland-sidenav__link maryland-sidenav__link--level-2\" data-drupal-link-system-path=\"node/14\" href=\"/funding/loans-historic-preservation\">Loans for Historic Preservation</a>\n</li>\n</ul>\n</li>\n</ul>\n</nav>\n</aside>\n<div class=\"margin-y-8 desktop:margin-top-10 desktop:margin-bottom-15 grid-col-12 desktop:grid-col-8\" id=\"page-content\">\n<div>\n<div class=\"usa-prose maryland-toc-target\">\n<section aria-labelledby=\"promo\" class=\"maryland-promo maryland-promo--illustration maryland-promo--illustration-statehouse\">\n<div class=\"maryland-promo__container\">\n<div class=\"maryland-promo__row\">\n<div class=\"maryland-promo__title-container\">\n<h2 class=\"maryland-promo__title\" id=\"promo\">Grants portal</h2>\n</div>\n<div class=\"maryland-promo__content-container\">\n<div class=\"maryland-promo__description\">\n<p>Apply for, monitor, and manage grants in one easy-to-access spot.</p>\n</div>\n<a class=\"maryland-promo__link\" href=\"https://bbgm-apply.yourcausegrants.com/apply/auth/signin\">Log in</a>\n</div>\n</div>\n</div>\n</section>\n<h2>Open funding opportunities</h2><ul><li><a class=\"maryland-link\" href=\"https://mht.prod.maryland.gov/funding/african-american-heritage-preservation-program-grants/aahpp-non-capital-grants\">Speaker Adrienne A. Jones African American Heritage Preservation Program Non-Capital Grants</a> (closes November 20)</li></ul><p><a class=\"maryland-link\" data-entity-type=\"external\" href=\"https://public.govdelivery.com/accounts/MDMDP/subscriber/new?qsp=CODE_MHT\">Stay connected</a> through MHT’s newsletter or follow us on social media to receive grant program updates, webinar information, and other announcements. </p><p>Any event details will be on our <a class=\"maryland-link\" data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"4f92884f-20b8-4493-9398-083eab6c3935\" href=\"/upcoming-events-page\" title=\"Upcoming Events page\">Upcoming Events</a> page.  </p><h2>Step 1: See if you qualify </h2><p dir=\"ltr\">Before starting your application, carefully read the guidelines and requirements for the grant program you’re interested in. Requirements vary, but you may need to consider: </p><ul><li dir=\"ltr\">Do you represent a qualifying applicant organization?</li><li dir=\"ltr\">Does your project meet the goals of the program?</li><li dir=\"ltr\">Can you complete your project within the grant timeframe? </li></ul><p dir=\"ltr\">If you have questions about guidelines and requirements, please contact the staff person listed on the grant program web page, which can be found in the sidebar. </p><h2>Step 2: Create (or update) your portal account </h2><p dir=\"ltr\">All applicants – new and returning – must create an account in <a class=\"maryland-link\" data-entity-type=\"external\" href=\"https://bbgm-apply.yourcausegrants.com/apply/auth/signin\">the new grants portal</a>. </p><p dir=\"ltr\">If you use other Blackbaud products, you may use the same Blackbaud ID. See the <a class=\"maryland-link\" data-entity-substitution=\"media_download_inline\" data-entity-type=\"media\" data-entity-uuid=\"ec2afecd-d362-4d3f-a00f-d775e0a52980\" href=\"/media/33\" title=\"Creating a New Grants Portal Account\">Quick-start guide - PDF - 598.7 KB</a> for help creating an account. </p><h2>Step 3: Prepare your materials </h2><p dir=\"ltr\">Before starting your application, gather the following materials (requirements vary by program): </p><ul><li dir=\"ltr\">Project summary and goals</li><li dir=\"ltr\">Work plan, budget, and timeline</li><li dir=\"ltr\">Photos, maps, or drawings (if applicable)</li><li dir=\"ltr\">Proof of eligibility (for example, National Register status, nonprofit status, site control – as required by your program</li><li dir=\"ltr\">Partner letters or match documentation (if required) </li></ul><p dir=\"ltr\">See your program’s current guidelines for exact requirements. </p><h2>Step 4: Complete &amp; submit your application </h2><ol><li dir=\"ltr\">Log in to the <a class=\"maryland-link\" data-entity-type=\"external\" href=\"https://bbgm-apply.yourcausegrants.com/apply/auth/signin\">grants portal</a>.</li><li dir=\"ltr\">Select the correct program and start a new application – this may include an Intent to Apply stage before the application, so check each program’s requirements.</li><li dir=\"ltr\">Complete all required fields and upload attachments.</li><li dir=\"ltr\">Save your work often. The portal autosaves, but it’s best to be careful.</li><li dir=\"ltr\">Submit your application before your program’s posted deadline. Many programs have fixed open and close dates, but others accept rolling submissions.  </li></ol><h2>Step 5: After you apply </h2><ul><li dir=\"ltr\">You’ll receive emails from the grants system about status and any requests for changes.</li><li dir=\"ltr\">If you receive a grant, you’ll complete required reports and submit any necessary documentation in the same portal account. </li></ul><h2>Frequently Asked Questions</h2>\n<section aria-labelledby=\"accordion\" class=\"maryland-accordion\">\n<div class=\"maryland-accordion__list\">\n<h2 class=\"maryland-accordion__list--heading\" id=\"accordion\">\n<span>Grants portal account &amp; access </span>\n</h2>\n</div>\n<div class=\"maryland-accordion__items\">\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content\" aria-expanded=\"true\" class=\"maryland-accordion__button\" id=\"accordion-item\" type=\"button\">\n              Do I need a new account if I have applied with MHT before? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item\" class=\"maryland-accordion__content\" id=\"accordion-content\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">Yes. All applicants need an account in the new grants portal. </p></div>\n</div>\n</div>\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--2\" aria-expanded=\"false\" class=\"maryland-accordion__button\" id=\"accordion-item--2\" type=\"button\">\n              Can I sign in with my Blackbaud ID (e.g., used for other products)? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--2\" class=\"maryland-accordion__content\" hidden=\"\" id=\"accordion-content--2\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">Yes. If you already use products like Raiser’s Edge, you can use the same Blackbaud ID.  </p></div>\n</div>\n</div>\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--3\" aria-expanded=\"false\" class=\"maryland-accordion__button\" id=\"accordion-item--3\" type=\"button\">\n              What if I forget my password? What are the password requirements? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--3\" class=\"maryland-accordion__content\" hidden=\"\" id=\"accordion-content--3\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">Click “Forgot password?” on the login screen. You’ll receive a code to reset it. </p><p dir=\"ltr\">Passwords must be at least 12 characters and include at least three of these: lowercase letter, uppercase letter, number, special character. </p></div>\n</div>\n</div>\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--4\" aria-expanded=\"false\" class=\"maryland-accordion__button\" id=\"accordion-item--4\" type=\"button\">\n              Which browsers work best? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--4\" class=\"maryland-accordion__content\" hidden=\"\" id=\"accordion-content--4\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">Use Chrome, Firefox, or Edge. The portal is mobile-friendly, supports screen readers, autosaves drafts, and can translate text into multiple languages. </p></div>\n</div>\n</div>\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--5\" aria-expanded=\"false\" class=\"maryland-accordion__button\" id=\"accordion-item--5\" type=\"button\">\n              What file types and sizes can I upload? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--5\" class=\"maryland-accordion__content\" hidden=\"\" id=\"accordion-content--5\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">You can upload files up to 29 MB (.pdf, .jpg, .xls, .docx, etc.). The portal will tell you which format is needed for each question. </p></div>\n</div>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"accordion--2\" class=\"maryland-accordion\">\n<div class=\"maryland-accordion__list\">\n<h2 class=\"maryland-accordion__list--heading\" id=\"accordion--2\">\n<span>Applying for a grant</span>\n</h2>\n</div>\n<div class=\"maryland-accordion__items\">\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--6\" aria-expanded=\"true\" class=\"maryland-accordion__button\" id=\"accordion-item--6\" type=\"button\">\n              Where do I start a new application? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--6\" class=\"maryland-accordion__content\" id=\"accordion-content--6\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">Go to the “Open Funding Opportunities” section of this page, select the program you want, and click “Apply Now.” This opens the application in your portal. Links to program applications can also be found on the program webpages.  </p></div>\n</div>\n</div>\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--7\" aria-expanded=\"false\" class=\"maryland-accordion__button\" id=\"accordion-item--7\" type=\"button\">\n              Can I save my work and collaborate on an application? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--7\" class=\"maryland-accordion__content\" hidden=\"\" id=\"accordion-content--7\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">Yes. The portal autosaves your work, and drafts are stored under “My Applications.” You can also add other registered users – like team members or consultants – to help complete the application. For longer answers, it’s a good idea to draft responses in Microsoft Word or another document first, then paste them into the portal. </p></div>\n</div>\n</div>\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--8\" aria-expanded=\"false\" class=\"maryland-accordion__button\" id=\"accordion-item--8\" type=\"button\">\n              Can I download a copy of my application? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--8\" class=\"maryland-accordion__content\" hidden=\"\" id=\"accordion-content--8\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">Yes. You can download a draft or final submitted version for your records. </p></div>\n</div>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"accordion--3\" class=\"maryland-accordion\">\n<div class=\"maryland-accordion__list\">\n<h2 class=\"maryland-accordion__list--heading\" id=\"accordion--3\">\n<span>Managing grant awards &amp; reports</span>\n</h2>\n</div>\n<div class=\"maryland-accordion__items\">\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--9\" aria-expanded=\"true\" class=\"maryland-accordion__button\" id=\"accordion-item--9\" type=\"button\">\n              How do I submit reports if I receive a grant award? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--9\" class=\"maryland-accordion__content\" id=\"accordion-content--9\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">Log in to the portal and find your award under “My Awards.” Any required reports will be listed there with links to open and complete them. </p></div>\n</div>\n</div>\n<div class=\"maryland-accordion__item\">\n<h3 class=\"maryland-accordion__heading\">\n<button aria-controls=\"accordion-content--10\" aria-expanded=\"false\" class=\"maryland-accordion__button\" id=\"accordion-item--10\" type=\"button\">\n              What programs use this portal? \n            </button>\n</h3>\n<div aria-labelledby=\"accordion-item--10\" class=\"maryland-accordion__content\" hidden=\"\" id=\"accordion-content--10\" role=\"region\">\n<div class=\"usa-prose\"><p dir=\"ltr\">All programs that MHT administers use this portal to process grant requests, including the: </p><ul><li><a class=\"maryland-link\" data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"a39fa706-b4e6-4787-9d47-d4edf6344556\" href=\"/planning-protection/maryland-heritage-areas-program\" title=\"Maryland Heritage Areas Program\">Maryland Heritage Areas Program</a> (overseen by the Maryland Heritage Areas Authority)</li><li><a class=\"maryland-link\" data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"be2fb934-0326-4d23-adb7-d180be671a1d\" href=\"/node/9\">African American Heritage Preservation Program</a> (in partnership with the Maryland Commission on African American History and Culture)</li><li><a class=\"maryland-link\" data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"45ed96a5-cdf9-4483-ba26-7f77795d8b53\" href=\"/funding/historic-preservation-capital-grant-program\" title=\"Historic Preservation Capital Grant Program\">Historic Preservation Capital Grant Program</a></li><li><a class=\"maryland-link\" data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"85472c5b-c124-4caa-b048-08e7c60cf564\" href=\"/funding/historic-preservation-non-capital-grant-program\" title=\"Historic Preservation Non-Capital Grant Program\">Historic Preservation Non-Capital Grant Program</a> </li></ul></div>\n</div>\n</div>\n</div>\n</section>\n<section aria-labelledby=\"automatic-list-376\" class=\"maryland-automatic-list\">\n<div class=\"maryland-card-group__header\">\n<div class=\"maryland-card-group__header-content\">\n<h2 class=\"maryland-card-group__title visually-hidden usa-sr-only\" id=\"automatic-list-376\"><span>grants contact list</span>\n</h2>\n</div>\n</div>\n<div><div class=\"views-element-container\" id=\"block-views-block-automatic-list-blocks-content-block-automatic-list-contact\">\n<div><div class=\"js-view-dom-id-1b5861466203d6ba69942c91417fdb933b248cfa89182dd87e5917d9edb75842\">\n<ul class=\"maryland-card-group\">\n<li class=\"maryland-card maryland-card--full\">\n<div class=\"maryland-card__container\">\n<div class=\"maryland-card__header\">\n<a class=\"maryland-link\" href=\"/about/staff-directory/search-staff-program/grants-program\">\n<h3 class=\"maryland-card__heading\">Grants Program</h3>\n</a>\n</div>\n<div class=\"maryland-card__body\">\n<div class=\"maryland-link--labelled\">\n<span class=\"maryland-link__label\" id=\"contact-email-\">Email</span>\n<a aria-describedby=\"contact-email-\" class=\"maryland-link\" href=\"/cdn-cgi/l/email-protection#8de0e5f9a3eaffece3f9fecde0ecfff4e1ece3e9a3eae2fb\">\n<span class=\"__cf_email__\" data-cfemail=\"c1aca9b5efa6b3a0afb5b281aca0b3b8ada0afa5efa6aeb7\">[email protected]</span>\n</a>\n</div>\n</div>\n</div>\n</li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n</section>\n</div>\n</div>\n</div>\n</div>\n</div>\n</main>",
