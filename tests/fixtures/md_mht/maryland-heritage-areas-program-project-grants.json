 "main_html": "<main id=\"main-content\" tabindex=\"-1\">\n<div>\n<div id=\"block-maryland-hero\">\n<section aria-labelledby=\"node-12-title\" class=\"maryland-hero maryland-hero--basic has-illustration has-image\">\n<div class=\"maryland-hero__container\">\n<div class=\"maryland-hero__row\">\n<div class=\"maryland-hero__content\">\n<div class=\"maryland-hero__breadcrumb\">\n<div class=\"maryland-breadcrumb__wrapper maryland-breadcrumb__wrapper--dark\">\n<nav aria-label=\"Breadcrumbs\" class=\"usa-breadcrumb maryland-breadcrumb maryland-breadcrumb--dark\">\n<ol class=\"usa-breadcrumb__list maryland-breadcrumb__list\">\n<li class=\"usa-breadcrumb__list-item maryland-breadcrumb__list-item\">\n<a class=\"usa-breadcrumb__link maryland-breadcrumb__link\" href=\"/\">\n<span>Home</span>\n</a>\n</li>\n<li class=\"usa-breadcrumb__list-item maryland-breadcrumb__list-item\">\n<a class=\"usa-breadcrumb__link maryland-breadcrumb__link\" href=\"/planning-protection\">\n<span>Planning &amp; Protection</span>\n</a>\n</li>\n<li class=\"usa-breadcrumb__list-item maryland-breadcrumb__list-item\">\n<a class=\"usa-breadcrumb__link maryland-breadcrumb__link\" href=\"/planning-protection/maryland-heritage-areas-program\">\n<span>Maryland Heritage Areas Program</span>\n</a>\n</li>\n<li aria-current=\"page\" class=\"usa-breadcrumb__list-item maryland-breadcrumb__list-item usa-current\">\n<span class=\"usa-breadcrumb__link maryland-breadcrumb__link\">\n<span>Maryland Heritage Areas Program Project Grants</span>\n</span>\n</li>\n</ol>\n</nav>\n</div>\n</div>\n<h1 class=\"maryland-hero__title\" id=\"node-12-title\"><span>Maryland Heritage Areas Program Project Grants</span>\n</h1>\n</div>\n<div class=\"maryland-hero__img-container\">\n<figure class=\"maryland-hero__image\">\n<img alt=\"Bronze statue of Harriet Tubman holding a golden star, located in front of a red brick building.\" height=\"600\" loading=\"lazy\" src=\"https://cdn.maryland.gov/maryland-cms/prod/mht/s3fs-public/styles/3_4_450x